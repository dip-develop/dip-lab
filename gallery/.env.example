# Gallery (Immich) - needs database credentials

# Bind address for internal access
BIND_IP=0.0.0.0

# Domain for Traefik
DOMAIN=gallery.example.com

GALLERY_DB_NAME=gallery

# Database connection
POSTGRES_USER=app
POSTGRES_PASSWORD=
REDIS_PASSWORD=

TZ=Europe/Berlin

# Object Storage (S3-compatible) - uncomment to enable
# Leave empty to use local NVMe storage
# OBJECT_STORAGE_TYPE=s3
# OBJECT_STORAGE_BUCKET=gallery
# OBJECT_STORAGE_REGION=default
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_PREFIX=assets