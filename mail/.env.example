# Mail (Mailcow) - Corporate Mail Server
# https://mail.example.com
# Required: Copy to mail.env and adjust values

# HTTP/HTTPS ports (used by nginx-mailcow)
HTTP_PORT=80
HTTPS_PORT=443

# SMTP ports
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587

# IMAP ports
IMAP_PORT=143
IMAPS_PORT=993

# POP3 ports
POP_PORT=110
POPS_PORT=995

# Sieve port (mail filtering)
SIEVE_PORT=4190

# Dovecot admin port
DOVEVOT_PORT=9993

# Database configuration (if using external DB, otherwise leave as is)
DBNAME=mail
DBUSER=app
DBPASS=
DBROOT=

# Redis password
EDISPASS=

# Timezone
TZ=Europe/Berlin

# Mail hostname (FQDN)
# MAIL_HOSTNAME=mail.example.com

# Skip resource-heavy components if needed
# SKIP_CLAMD=y      # Disable ClamAV (saves ~1GB RAM)
# SKIP_SOLR=y       # Disable full-text search (saves ~1GB RAM)
# SKIP_SOGO=n       # Disable SOGo webmail
