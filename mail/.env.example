# Mail (Mailcow) - Corporate Mail Server
# https://mail.example.com

# Basic settings
TZ=Europe/Berlin
MAILCOW_DOMAIN=example.com

# MySQL passwords
DBNAME=mail
DBPASS=
DBROOTPASS=

# Ports (do not change!)
HTTP_PORT=80
HTTPS_PORT=443
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995
SIEVE_PORT=4190
DOVEVOT_PORT=9993
MYSQL_PORT=3306

# HTTPS/Let's Encrypt
ACME_NETWORK=web
LETSENCRYPT=true

# Disable resource-intensive components
SKIP_CLAMD=true
SKIP_SOLR=true

# Mail domains and settings
WC=*.example.com
EOF=postmaster@example.com