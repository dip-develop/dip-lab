# dev-agent - developer workstation container (OpenCode 2)
#
# Image builds Debian + Flutter SDK (stable) + opencode CLI v2 (version
# pinning supported via OPENCODE_VERSION -- a V2 release string like
# 2.0.3, not a V1-style one).
# Runs `opencode serve` on 0.0.0.0:4096 as the container's main process.
#
# UID/GID are optional - defaults to 1000:1000 if not set. Set to match
# your host user's UID/GID if you need bind-mounted files to keep
# matching ownership.

# DEVELOP_UID / DEVELOP_GID: optional. Host user that owns the bind-mounted
# dirs. Run `id -u` / `id -g` on the host and put the values here.
# Defaults to 1000:1000 if not set.
DEVELOP_UID=
DEVELOP_GID=

# OPENCODE_VERSION: optional. Pin the opencode CLI version installed at
# image build time (e.g. 2.0.3 -- a real V2 release string) for
# reproducible rebuilds. Default: latest (the current V2 release).
# Requires a rebuild to take effect:
#   ./manager.sh build dev-agent
OPENCODE_VERSION=latest

# SERVERPOD_CLI_VERSION: optional. Pins the serverpod CLI release installed at image build.
SERVERPOD_CLI_VERSION=4.0.0-rc.1

# OPENCODE_SERVER_PASSWORD: long random string that protects the always-on
# `opencode serve` web UI/API. Generate with:  openssl rand -hex 32
# Without this set, the container will refuse to start (checked by
# docker compose at runtime).
OPENCODE_SERVER_PASSWORD=

# Model provider: no API key goes in this file. After the container is
# up, open the web UI, run `/connect`, and pick "OpenCode Go" -- the
# credential is written to auth.json in the opencode-data volume, not
# to .env or any git-tracked file.

# GH_TOKEN: GitHub personal access token for the `gh` CLI, used for
# PR/issue operations. Passed as an env var, so it survives container
# recreation without being stored in container state. Create one at
# https://github.com/settings/tokens (repo scope is enough for PR/issue
# work). Alternative: run `gh auth login` inside the container - but
# that login does NOT survive container recreation.
GH_TOKEN=

# Bind address for the opencode serve port (4096).
# - 127.0.0.1  = reachable only from the Docker host itself
# - 0.0.0.0    = reachable from anywhere the host's network reaches
# Default: 127.0.0.1 (this is a developer tool, not a public service).
BIND_IP=127.0.0.1

# Default Git author/committer identity inside the container.
# Override per-project with `git config user.name/email` inside the container.
GIT_AUTHOR_NAME=dev-agent
GIT_AUTHOR_EMAIL=dev-agent@diplab.local
GIT_COMMITTER_NAME=dev-agent
GIT_COMMITTER_EMAIL=dev-agent@diplab.local

# ── Isolated test database credentials (set by databases/.env) ─────────────
# These are the TEST_* values from databases/.env, surfaced here so
# dev-agent can connect for running tests. They grant access ONLY to
# databases whose name starts with `dev_test_` - they cannot drop or
# alter any prod database (gallery, automation, docs, app, ccnet_db,
# seafile_db, seahub_db, cloud).
#
# Source-of-truth lives in databases/.env - mirror the values here
# (manager.sh setup does NOT copy them automatically). Leave blank to
# disable DB access for the agent.
TEST_POSTGRES_USER=
TEST_POSTGRES_PASSWORD=
TEST_POSTGRES_DB=
TEST_MYSQL_USER=
TEST_MYSQL_PASSWORD=
TEST_MYSQL_DB=
TEST_REDIS_DB=15
TEST_REDIS_PASSWORD=

# Hard guard. When true (default), the dev-agent entrypoint prepends
# a `db-safe` wrapper to PATH that refuses any psql/mysql/redis-cli
# command that targets a non-test database or non-test Redis DB index.
# Set to false only if you know what you're doing.
DB_SAFETY_GUARD=true

# N8N_WEBHOOK_URL: optional. n8n webhook that data/config/plugins/notify-n8n.js
# POSTs session events to (session.idle, permission.asked, session.error) so
# the operator is pinged outside the container. Metadata only, never message
# content. Leave empty to disable the plugin entirely. Create a "Webhooks"
# node in n8n and paste its URL here.
#
# STATUS: this plugin is still in its V1 shape and has NOT been ported to
# the V2 plugin API (Plugin.define({id, setup(ctx)})) -- see AGENTS.md /
# the PR discussion. Leave this empty until it's ported; setting it does
# not guarantee notifications actually work under OpenCode 2.
N8N_WEBHOOK_URL=
