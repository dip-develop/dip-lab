// pi permission policy, ported from opencode.jsonc shared permissions.
// Last matching rule wins inside each section. Agent frontmatter (data/pi/agents) layers on top.
// Bash guards (git push to protected branches/force/delete, gh secret/api writes, .env reads) come last.
{
  "defaultPolicy": {
    "tools": "ask",
    "bash": "ask",
    "mcp": "deny",
    "skills": "allow",
    "special": "ask"
  },
  "tools": {
    "*": "ask",
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "read:**/*.env": "deny",
    "read:**/*.env.*": "deny",
    "read:**/*.env.example": "allow",
    "edit": "ask",
    "write": "ask",
    "task": "deny",
    "mcp": "deny",
    "web_search": "allow",
    "fetch_content": "allow",
    "get_search_content": "allow",
    "lens_diagnostics": "allow",
    "lens_diagnostic_mark": "allow",
    "ffgrep": "allow",
    "fffind": "allow",
    "multi_grep": "allow",
    "todo": "allow",
    "plannotator_submit_plan": "allow",
    "memory_read": "allow",
    "memory_search": "allow",
    "memory_status": "allow",
    "memory_write": "allow",
    "memory_restore": "allow",
    "memory_forget": "ask",
    "scratchpad": "allow",
    "source_check": "allow",
    "pilens_diagnostics": "allow",
    "pilens_health": "allow",
    "pilens_project_scan": "allow",
    "pilens_project_report": "allow",
    "pilens_module_report": "allow",
    "pilens_symbol_search": "allow",
    "pilens_read_symbol": "allow",
    "pilens_read_enclosing": "allow",
    "pilens_ast_grep_search": "allow",
    "pilens_lsp_navigation": "allow",
    "pilens_effective_config": "allow",
    "pilens_latency": "allow",
    "pilens_turn_end": "allow",
    "pilens_session_start": "allow",
    "pilens_session_end": "allow",
    "pilens_ast_grep_replace": "ask",
    "pilens_rebuild": "ask"
  },
  "bash": {
    "*": "ask",
    "ls *": "allow",
    "cat *": "allow",
    "head *": "allow",
    "tail *": "allow",
    "grep *": "allow",
    "rg *": "allow",
    "sed *": "allow",
    "find *": "allow",
    "tree *": "allow",
    "wc *": "allow",
    "sort *": "allow",
    "uniq *": "allow",
    "diff *": "allow",
    "awk *": "allow",
    "tr *": "allow",
    "cut *": "allow",
    "jq *": "allow",
    "pwd": "allow",
    "echo *": "allow",
    "date*": "allow",
    "which *": "allow",
    "uname*": "allow",
    "sleep*": "allow",
    "true": "allow",
    "git status*": "allow",
    "git diff*": "allow",
    "git log*": "allow",
    "git show *": "allow",
    "git branch*": "allow",
    "git grep *": "allow",
    "git rev-parse*": "allow",
    "git ls-files*": "allow",
    "git remote*": "allow",
    "git fetch*": "allow",
    "git config --get*": "allow",
    "git add *": "allow",
    "git commit *": "allow",
    "git checkout *": "allow",
    "git stash *": "allow",
    "git merge *": "allow",
    "git rebase *": "allow",
    "git push *": "allow",
    "gh pr list*": "allow",
    "gh pr view*": "allow",
    "gh pr checks*": "allow",
    "gh pr diff*": "allow",
    "gh issue view*": "allow",
    "gh issue list*": "allow",
    "gh run list*": "allow",
    "gh run view*": "allow",
    "dart analyze*": "allow",
    "dart format*": "allow",
    "dart test*": "allow",
    "dart pub *": "allow",
    "flutter test*": "allow",
    "flutter analyze*": "allow",
    "flutter doctor*": "allow",
    "flutter devices*": "allow",
    "flutter --version*": "allow",
    "serverpod generate*": "allow",
    "serverpod analyze*": "allow",
    "jaspr build*": "allow",
    "gh pr merge*": "ask",
    "git push * main*": "deny",
    "git push * master*": "deny",
    "git push * develop*": "deny",
    "git push*--force*": "deny",
    "git push*-f": "deny",
    "git push*-f *": "deny",
    "git push*:main*": "deny",
    "git push*:master*": "deny",
    "git push*:develop*": "deny",
    "git push --delete*": "deny",
    "git push * --delete*": "deny",
    "git push :*": "deny",
    "git push * :*": "deny",
    "git filter-branch*": "deny",
    "git filter-repo*": "deny",
    "git update-ref*": "deny",
    "git reflog expire*": "deny",
    "gh secret*": "deny",
    "gh repo delete*": "deny",
    "gh release delete*": "deny",
    "gh workflow delete*": "deny",
    "gh auth token*": "deny",
    "gh auth status*--show-token*": "deny",
    "gh api*-X PUT*": "deny",
    "gh api*-X DELETE*": "deny",
    "gh api*-X PATCH*": "deny",
    "gh api*--method PUT*": "deny",
    "gh api*--method DELETE*": "deny",
    "gh api*--method PATCH*": "deny",
    "gh pr close*--delete-branch*": "deny",
    "cat *.env*": "deny",
    "head *.env*": "deny",
    "tail *.env*": "deny",
    "less *.env*": "deny",
    "sed *.env*": "deny",
    "rg *.env*": "deny",
    "grep *.env*": "deny",
    "printenv*": "deny"
  },
  "mcp": {
    "*": "deny"
  },
  "skills": {
    "*": "allow"
  },
  "special": {
    "external_directory": "ask",
    "external_directory:/home/develop/projects/*": "allow",
    "external_directory:/home/develop/develop/*": "allow",
    "external_directory:/home/develop/.pub-cache/*": "allow",
    "external_directory:/tmp/opencode/*": "allow"
  }
}
