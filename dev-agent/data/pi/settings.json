{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls"
  ],
  "prompts": [
    "~/.agents/commands"
  ],
  "subagents": {
    "disableBuiltins": true
  },
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "never"
}