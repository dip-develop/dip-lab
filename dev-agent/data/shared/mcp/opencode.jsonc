{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "jaspr": {
        "type": "remote",
        "url": "https://docs.jaspr.site/mcp",
        "disabled": false
      },
      "dart": {
        "type": "local",
        "command": [
          "dart",
          "mcp-server"
        ],
        "disabled": false
      },
      "serverpod": {
        "type": "local",
        "command": [
          "serverpod_mcp"
        ],
        "disabled": false
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer {env:GH_TOKEN}",
          "X-MCP-Toolsets": "context,repos,issues,pull_requests"
        },
        "oauth": false,
        "disabled": false
      }
    }
  }
}
