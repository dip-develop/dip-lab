{
  "mcpServers": {
    "jaspr": {
      "url": "https://docs.jaspr.site/mcp"
    },
    "dart": {
      "command": "dart",
      "args": [
        "mcp-server"
      ]
    },
    "serverpod": {
      "command": "serverpod_mcp",
      "args": []
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GH_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests"
      }
    },
    "gtm": {
      "url": "http://gtm-mcp:8080/",
      "headers": {
        "Authorization": "Bearer ${GTM_MCP_API_KEY}"
      }
    },
    "google_analytics": {
      "command": "analytics-mcp",
      "args": [],
      "enabled": false
    }
  }
}
