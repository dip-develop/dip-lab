{
  "mcpServers": {
    "jaspr": {
      "url": "https://docs.jaspr.site/mcp"
    },
    "dart": {
      "command": "dart",
      "args": [
        "mcp-server"
      ]
    },
    "serverpod": {
      "command": "serverpod_mcp",
      "args": []
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GH_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests"
      }
    }
  }
}
