# Mailcow - Corporate Mail
# https://mail.dipdev.de
# ВНИМАНИЕ: Требует ручной установки через git

# https://mailcow.digitalocean.cloudcow.email
# https://github.com/mailcow/mailcow-dockerized

# Основные настройки
TZ=Europe/Berlin
MAILCOW_DOMAIN=dipdev.de

# MySQL пароли
DBNAME=mailcow
DBPASS=...
DBROOTPASS=...

# Порты (не менять!)
HTTP_PORT=80
HTTPS_PORT=443
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995
SIEVE_PORT=4190
DOVEVOT_PORT=9993
MYSQL_PORT=3306

# HTTPS/Let's Encrypt
ACME_NETWORK=web
LETSENCRYPT=true

# Отключаем ресурсоемкие
SKIP_CLAMD=true
SKIP_SOLR=true

# Почтовые ящики
WC=*.dipdev.de
EOF=postmaster@dipdev.de