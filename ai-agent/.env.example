# Hermes Agent - AI Agent
# https://ai.example.com

# Bind address for internal access.example.com
BIND_IP=0.0.0.0

# Domain for Traefik
DOMAIN=ai.example.com

HERMES_DASHBOARD=true
GATEWAY_DASHBOARD_INSECURE=true

API_SERVER_ENABLED=true
API_SERVER_CORS_ORIGINS='*'
API_SERVER_KEY=

HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=



HERMES_ALLOWED_ORIGINS=https://*.example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Cross-service: opt-in dev-agents (opencode) ─────────────────────────────
# Hermes can call the dev-agents opencode serve API at this URL.
# Hostname `dev-agents` is the Docker container name on the shared
# `internal` network. Port 4096 is the opencode serve web UI/API.
# The dev-agents service must be started for this URL to resolve:
#   ./manager.sh start dev-agents
# Leave OPENCODE_SERVER_PASSWORD empty to disable cross-service calls.
OPENCODE_URL=http://dev-agents:4096
OPENCODE_SERVER_PASSWORD=
# Set to `true` to allow Hermes agents to invoke opencode automatically
# (e.g. as a tool). `false` means Hermes knows about opencode but won't
# call it without explicit operator approval.
HERMES_OPENCODE_AUTOCALL=false

# ── Cross-service: Seafile (cloud) ──────────────────────────────────────────
# Hermes can call the Seafile HTTP API on the shared `internal` network.
# Hostname `cloud` is the Docker container name; port 80 is the Seafile
# web UI / seahub API inside the container.
#
# Required:
#   SEAFILE_ADMIN_EMAIL     - admin account email (set during first start)
#   SEAFILE_ADMIN_PASSWORD  - admin account password (set during first start
#                             or via the Seafile web UI later)
# Optional:
#   SEAFILE_API_TOKEN       - if you've created a personal access token
#                             in Seafile (User Settings -> Personal Access
#                             Tokens), put it here. Token auth is preferred
#                             over username/password for API calls.
#
# Leave all three empty to disable Seafile integration.
SEAFILE_URL=http://cloud
SEAFILE_ADMIN_EMAIL=
SEAFILE_ADMIN_PASSWORD=
SEAFILE_API_TOKEN=

# ── Cross-service: Immich (gallery) ─────────────────────────────────────────
# Hermes can call the Immich REST API on the shared `internal` network.
# Hostname `gallery` is the Docker container name; port 2283 is the
# Immich server inside the container.
#
# Required:
#   IMMICH_API_KEY  - generate in the Immich web UI:
#                     Admin -> Settings -> API Keys -> New API Key
#                     Copy the value here.
#
# Leave IMMICH_API_KEY empty to disable Immich integration.
IMMICH_URL=http://gallery:2283
IMMICH_API_KEY=

# ── Cross-service: Paperless (docs) ─────────────────────────────────────────
# Hermes can call the Paperless-ngx REST API on the `internal` network.
# Hostname `docs` is the Docker container name; port 8000 is Paperless
# inside the container.
#
# Generate the API token in the Paperless web UI:
#   User menu (top right) -> My Profile -> Authentication Token
#   Or:   Admin -> Users -> (user) -> API Token -> Generate
#
# Usage: pass it as `Authorization: Token <DOCS_API_TOKEN>` in the
# header of every Paperless API request.
#
# Leave DOCS_API_TOKEN empty to disable Paperless integration.
DOCS_URL=http://docs:8000
DOCS_API_TOKEN=

# ── Cross-service: Vaultwarden (passwords) ─────────────────────────────────
# Hermes can call the Vaultwarden (Bitwarden-compatible) API on the
# `internal` network. Hostname `passwords` is the Docker container name;
# port 80 is the Vaultwarden web UI / API inside the container.
#
# The recommended way to authenticate is to log in once with the
# master account to obtain a personal access token:
#   POST /identity/connect/token
#     grant_type=password&username=<email>&password=<password>
# Then use the returned `access_token` for subsequent API calls:
#   Authorization: Bearer <PASSWORDS_API_KEY>
#
# Alternatively, paste a long-lived client_credentials token (created
# via /account/security in the Vaultwarden web UI).
#
# Leave PASSWORDS_API_KEY empty to disable Vaultwarden integration.
PASSWORDS_URL=http://passwords
PASSWORDS_API_KEY=
