# Containers (Portainer) - container management UI
# https://admin.example.com
# Required: Create .env with your values
#
# The directory / compose service is named `containers` (not
# `dockerui`) so swapping Portainer for another UI later doesn't
# require renaming anything user-facing.

# Bind address for internal access
BIND_IP=0.0.0.0

# Domain for Traefik
DOMAIN=admin.example.com

# Admin password (set on first login at http://<host>:9000)
CONTAINERS_ADMIN_PASSWORD=
# Legacy: DOCKERUI_ADMIN_PASSWORD is still honored for backward
# compat with existing .env files. New deployments should use the
# CONTAINERS_ prefix.
DOCKERUI_ADMIN_PASSWORD=
