# Monitoring - Grafana, Prometheus, Loki
# https://monitor.example.com

TZ=Europe/Berlin

# Bind address for internal access
BIND_IP=10.0.0.1

# Domain for Traefik
DOMAIN=monitor.example.com

# Grafana credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# Retention
PROMETHEUS_RETENTION_DAYS=15
LOKI_RETENTION_DAYS=15