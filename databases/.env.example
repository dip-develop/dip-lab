# Databases - Shared PostgreSQL, MySQL, Redis
# Shared database service for all applications

# PostgreSQL (main database)
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

# PostgreSQL database names (per service)
GALLERY_DB_NAME=gallery
AUTOMATION_DB_NAME=automation
DOCS_DB_NAME=docs

# Redis (cache/queue)
REDIS_PASSWORD=

# MySQL (shared)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=

# Cloud database (created via init.sql)
MYSQL_CLOUD_USER=cloud
MYSQL_CLOUD_PASSWORD=