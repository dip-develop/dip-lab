# Databases - Shared PostgreSQL, MySQL, Redis
# Shared database service for all applications

# PostgreSQL (main database)
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

# PostgreSQL database names (per service)
GALLERY_DB_NAME=gallery
AUTOMATION_DB_NAME=automation
DOCS_DB_NAME=docs

# Redis (cache/queue)
REDIS_PASSWORD=

# MySQL (shared)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=

# Cloud database (created via init.sql)
MYSQL_CLOUD_USER=cloud
MYSQL_CLOUD_PASSWORD=

# ── Isolated test users (used by the opt-in dev-agents container) ─────────
# These credentials are created by init.sql / mysql-init.sql and grant
# access ONLY to databases whose name starts with `dev_test_`. The
# dev-agents container is wired to use these credentials instead of the
# prod ones, so a misbehaving test agent cannot drop a prod database
# even if it has root-equivalent intent.
#
# Required: leave at least one of these sets filled, or the dev-agents
# container will fail to talk to databases for testing.
#
# Generate with:  openssl rand -hex 24
TEST_POSTGRES_USER=dev_test
TEST_POSTGRES_PASSWORD=
# Initial test database (dev-agents can CREATE more starting with `dev_test_`)
TEST_POSTGRES_DB=dev_test_main

TEST_MYSQL_USER=dev_test
TEST_MYSQL_PASSWORD=
TEST_MYSQL_DB=dev_test_main

# Redis: test uses a dedicated DB index (default 15) so it can't touch
# the prod keys (DBs 0-14). The password is the SAME as the prod one
# (Redis ACL per-DB is not supported on a single instance, so we rely
# on the index + the fact that dev-agents only ever sets keys prefixed
# with `dev_test:`).
TEST_REDIS_DB=15
TEST_REDIS_PASSWORD=  # leave empty to reuse REDIS_PASSWORD above
