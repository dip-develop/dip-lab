# Databases - Shared PostgreSQL, MySQL, Redis
# Shared database service for all applications

# PostgreSQL (main database)
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app

# PostgreSQL database names (per service)
IMMICH_DB_NAME=immich
N8N_DB_NAME=n8n
NEXTCLOUD_DB_NAME=nextcloud
PAPERLESS_DB_NAME=paperless

# Redis (cache/queue)
REDIS_PASSWORD=

# MySQL (for mailcow - uses its own container)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=mailcow
MYSQL_USER=mailcow
MYSQL_PASSWORD=