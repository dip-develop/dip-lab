# Email mail service - needs no external DB (embedded RocksDB)

# Bind address for directly-published mail ports
BIND_IP=0.0.0.0

TZ=Europe/Berlin

# Domain for Traefik WebUI/HTTPS
DOMAIN=mail.example.com

# Primary mail domain
MAIL_DOMAIN=example.com

# Loopback port for setup/recovery wizard
EMAIL_SETUP_PORT=8080

# Recovery admin key for the setup wizard (generate: openssl rand -base64 32)
EMAIL_RECOVERY_ADMIN=