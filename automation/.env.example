# Automation (n8n) - needs database credentials

# Bind address for internal access
BIND_IP=0.0.0.0

# Domain for Traefik
DOMAIN=automation.example.com

AUTOMATION_DB_NAME=automation
AUTOMATION_ENCRYPTION_KEY=

# Database connection (shared with databases)
POSTGRES_USER=app
POSTGRES_PASSWORD=

TZ=Europe/Berlin

# Object Storage (S3-compatible) - uncomment to enable
# Leave empty to use local NVMe storage
# EXECUTIONS_DATA_S3_BUCKET=automation
# EXECUTIONS_DATA_S3_REGION=default
# EXECUTIONS_DATA_S3_ENDPOINT=
# EXECUTIONS_DATA_S3_ACCESS_KEY=
# EXECUTIONS_DATA_S3_SECRET_KEY=

# Cross-service access - uncomment to access other services' data (read-only)
# N8N_AUTOMATION_CLOUD_PATH=../cloud/data/cloud
# N8N_AUTOMATION_GALLERY_PATH=../gallery/data/gallery
# N8N_AUTOMATION_DOCS_PATH=../docs/data/docs