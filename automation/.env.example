# Automation (n8n) - needs database credentials

# Bind address for internal access
BIND_IP=0.0.0.0

# Domain for Traefik
DOMAIN=automation.example.com

AUTOMATION_DB_NAME=automation
AUTOMATION_ENCRYPTION_KEY=

# Database connection (shared with databases)
POSTGRES_USER=app
POSTGRES_PASSWORD=

TZ=Europe/Berlin

# Object Storage (S3-compatible) - uncomment to enable
# Leave empty to use local NVMe storage
# EXECUTIONS_DATA_S3_BUCKET=automation
# EXECUTIONS_DATA_S3_REGION=default
# EXECUTIONS_DATA_S3_ENDPOINT=
# EXECUTIONS_DATA_S3_ACCESS_KEY=
# EXECUTIONS_DATA_S3_SECRET_KEY=

# Cross-service access - uncomment to access other services' data (read-only)
# N8N_AUTOMATION_CLOUD_PATH=../cloud/data/cloud
# N8N_AUTOMATION_GALLERY_PATH=../gallery/data/gallery
# N8N_AUTOMATION_DOCS_PATH=../docs/data/docs

# ── Cross-service: dev-agents (opencode) ────────────────────────────────────
# n8n workflows can call the dev-agents opencode serve API via the
# HTTP Request node. Fill these in if you want to trigger opencode
# runs from a workflow.
#
# Both the URL and the password must match the values in
# dev-agents/.env. Leave OPENCODE_SERVER_PASSWORD empty to disable.
#
# Usage example (HTTP Request node):
#   Method:   POST
#   URL:      {{ $env.OPENCODE_URL }}/api/sessions
#   Headers:  Authorization: Bearer {{ $env.OPENCODE_SERVER_PASSWORD }}
#
# Hostname `dev-agents` is the Docker container name on the shared
# `internal` network. dev-agents ships with the `default` profile.
# If you switched to a smaller profile, start it explicitly:
#   ./manager.sh start dev-agents
OPENCODE_URL=http://dev-agents:4096
OPENCODE_SERVER_PASSWORD=

# ── Cross-service: Seafile (cloud) ──────────────────────────────────────────
# n8n workflows can call the Seafile HTTP API on the `internal` network.
# Hostname `cloud` is the Docker container name; port 80 is the Seafile
# web UI / seahub API inside the container.
#
# Usage in a workflow (HTTP Request node):
#   Method: GET
#   URL:    {{ $env.SEAFILE_URL }}/api2/repos/
#   Auth:   Generic Credential Type -> Header Auth
#           Authorization: Token {{ $env.SEAFILE_API_TOKEN }}
# Or, if you only have username/password:
#           Authorization: Basic base64(email:password)
#
# Leave all empty to disable Seafile integration.
SEAFILE_URL=http://cloud
SEAFILE_ADMIN_EMAIL=
SEAFILE_ADMIN_PASSWORD=
SEAFILE_API_TOKEN=

# ── Cross-service: Immich (gallery) ─────────────────────────────────────────
# n8n workflows can call the Immich REST API on the `internal` network.
# Hostname `gallery` is the Docker container name; port 2283 is Immich.
#
# Usage in a workflow (HTTP Request node):
#   Method:  GET
#   URL:     {{ $env.IMMICH_URL }}/api/server/ping
#   Headers: x-api-key: {{ $env.IMMICH_API_KEY }}
#
# Generate the API key in the Immich web UI:
#   Admin -> Settings -> API Keys -> New API Key
#
# Leave IMMICH_API_KEY empty to disable Immich integration.
IMMICH_URL=http://gallery:2283
IMMICH_API_KEY=

# ── Cross-service: Paperless (docs) ─────────────────────────────────────────
# n8n workflows can call the Paperless-ngx REST API on the `internal`
# network. Hostname `docs` is the Docker container name; port 8000 is
# Paperless inside the container.
#
# Generate the API token in the Paperless web UI:
#   User menu -> My Profile -> Authentication Token
#
# Usage in a workflow (HTTP Request node):
#   Method:  GET
#   URL:     {{ $env.DOCS_URL }}/api/documents/
#   Headers: Authorization: Token {{ $env.DOCS_API_TOKEN }}
#
# Leave DOCS_API_TOKEN empty to disable Paperless integration.
DOCS_URL=http://docs:8000
DOCS_API_TOKEN=

# ── Cross-service: Vaultwarden (passwords) ─────────────────────────────────
# n8n workflows can call the Vaultwarden (Bitwarden-compatible) API on
# the `internal` network. Hostname `passwords` is the Docker container
# name; port 80 is the Vaultwarden API inside the container.
#
# The simplest way to obtain an API key is to log in once with the
# master account via the OAuth2 password grant:
#   POST {{ $env.PASSWORDS_URL }}/identity/connect/token
#     grant_type=password&username=<email>&password=<password>
# Then reuse the returned `access_token`:
#   Headers: Authorization: Bearer {{ $env.PASSWORDS_API_KEY }}
#
# Leave PASSWORDS_API_KEY empty to disable Vaultwarden integration.
PASSWORDS_URL=http://passwords
PASSWORDS_API_KEY=
