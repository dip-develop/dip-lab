# Docs (Paperless) - needs database credentials

# Bind address for internal access
BIND_IP=0.0.0.0

# Domain for Traefik
DOMAIN=docs.example.com

DOCS_DB_NAME=docs
DOCS_SECRET_KEY=

# Database connection
POSTGRES_USER=app
POSTGRES_PASSWORD=
REDIS_PASSWORD=

TZ=Europe/Berlin

# Object Storage (S3-compatible) - uncomment to enable
# Leave empty to use local NVMe storage
# PAPERLESS_CONSUMPTION_DIR=
# PAPERLESS_ARCHIVE_DIR=
# Enable S3 in settings.py or admin panel when using object storage
# PAPERLESS_S3_BUCKET_NAME=docs
# PAPERLESS_S3_REGION=default
# PAPERLESS_S3_ENDPOINT=
# PAPERLESS_S3_ACCESS_KEY=
# PAPERLESS_S3_SECRET_KEY=

# Cross-service access - uncomment to access other services' data
# CLOUD_DATA_PATH=/mnt/object-storage/cloud/data