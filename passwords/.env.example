# Passwords (Vaultwarden) - Password Manager
# https://vault.example.com
# Required: Create .env with your values

# Bind address for internal access
BIND_IP=10.0.0.1

# Domain for Traefik
DOMAIN=vault.example.com

PASSWORDS_SIGNUPS_ALLOWED=false
PASSWORDS_ADMIN_TOKEN=

# Yubico 2FA (optional)
# YUBICO_CLIENT_ID=
# YUBICO_SECRET_KEY=
# YUBICO_SERVER=https://api.yubico.com/wsapi/2.0/oauth