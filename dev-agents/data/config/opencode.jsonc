{
  "$schema": "https://opencode.ai/config.json",
  //"model": "opencode/mimo-v2.5-free",
  //"small_model": "opencode/ling-3.0-flash-fin-free",
  "default_agent": "orchestrator",
  "share": "manual",
  // Global instruction files injected into every agent's system prompt
  // (primary and subagents). Paths resolve relative to this config
  // directory (bind-mounted at ~/.config/opencode in the container).
  "instructions": [
    "instructions/*.md"
  ],
  // subagent_depth intentionally omitted -> defaults to 1, which is exactly
  // "primary can call subagents, subagents can't call further subagents".
  // Every subagent below also explicitly sets task: deny, so this is now
  // belt-and-suspenders rather than the only thing closing that gap.
  "permission": {
    "external_directory": {
      "*": "ask",
      "/home/develop/projects/**": "allow"
    },
    // Secrets stay unreadable by default, even for agents with otherwise
    // broad read access.
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    // Shared baseline for ad-hoc/manual sessions using this config directly
    // (e.g. default_agent with no agent .md override). Each agent .md file
    // repeats the subset it needs rather than relying on partial merge with
    // this block -- confirm merge granularity on your opencode version
    // before trying to de-duplicate further.
    "bash": {
      "*": "ask",
      "sleep": "allow",
      "sleep *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "find *": "allow",
      "tree *": "allow",
      "xargs *": "allow",
      "wc *": "allow",
      "less *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "pwd": "allow",
      "pwd *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "date *": "allow",
      "which *": "allow",
      "uname *": "allow",
      "env *": "allow",
      "diff *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "chmod *": "allow",
      "ln *": "allow",
      "git -C *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git checkout *": "allow",
      "git stash *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git merge *": "allow",
      "git rebase *": "allow",
      "git tag *": "allow",
      "git fetch *": "allow",
      "git pull*": "allow",
      "git remote *": "allow",
      "dart analyze*": "allow",
      "dart format*": "allow",
      "dart test*": "allow",
      "dart pub *": "allow",
      "flutter test*": "allow",
      "flutter analyze*": "allow",
      "flutter --version*": "allow",
      "serverpod generate*": "allow",
      "jaspr build*": "allow",
      // git push: allowed in general, hard-denied to protected branches and
      // force-pushes at the permission layer (not just via prompt wording).
      // This covers direct pushes and refspec forms (e.g. HEAD:main,
      // :develop branch deletions).
      // Rules are evaluated in order with the LAST match winning, so the
      // specific denies must come after the general allow. These are simple
      // glob patterns, not full argument parsing -- test them against your
      // real usage before relying on them.
      "git push *": "allow",
      "git push * main*": "deny",
      "git push * master*": "deny",
      "git push * develop*": "deny",
      "git push*--force*": "deny",
      "git push*-f*": "deny",
      "git push*:main*": "deny",
      "git push*:master*": "deny",
      "git push*:develop*": "deny"
    }
  },
  "lsp": {
    "dart": {
      "command": [
        "dart",
        "language-server",
        "--client-id=opencode"
      ]
    },
    "serverpod": {
      "command": [
        "serverpod",
        "language-server"
      ]
    }
  },
  "mcp": {
    "jaspr": {
      "type": "remote",
      "url": "https://docs.jaspr.site/mcp",
      "enabled": true
    },
    "dart": {
      "type": "local",
      "command": [
        "dart",
        "mcp-server"
      ],
      "enabled": true
    },
    "serverpod": {
      "type": "local",
      "command": [
        "serverpod_mcp"
      ],
      "enabled": true
    }
  }
}