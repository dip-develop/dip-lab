{
  "_schema": "https://opencode.ai/config.json",
  "_readme": "See dev-agents/README.md for full documentation. After /connect inside opencode, run /models and replace every <set-...-model-id> with a real model ID from your provider. Never commit real credentials here.",

  "autoupdate": false,
  "subagent_depth": 1,
  "share": "manual",

  "lsp": {
    "dart": {
      "command": ["dart", "language-server", "--protocol=lsp"],
      "extensions": [".dart"]
    }
  },

  "mcp": {
    "dart": {
      "type": "local",
      "command": ["dart", "mcp-server"],
      "enabled": true
    }
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },

  "model": "<set-your-default-model-id>",

  "agent": {
    "orchestrator": {
      "mode": "primary",
      "model": "<set-mid-tier-model-id>",
      "prompt": "{file:./prompts/orchestrator.txt}",
      "maxTokens": 4096,
      "options": { "reasoningEffort": "medium" },
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    },

    "plan": {
      "mode": "primary",
      "model": "<set-cheap-model-id>",
      "maxTokens": 4096,
      "options": { "reasoningEffort": "low" },
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },

    "planner": {
      "mode": "subagent",
      "description": "Breaks a feature/bug request into an ordered list of concrete file-level steps. Does not write code.",
      "model": "<set-premium-model-id>",
      "maxTokens": 2048,
      "options": { "reasoningEffort": "medium" },
      "permission": {
        "edit": "deny",
        "bash": {
          "git status": "allow",
          "git log*": "allow",
          "git diff*": "allow",
          "*": "deny"
        }
      }
    },

    "coder": {
      "mode": "subagent",
      "description": "Implements one specific, already-scoped file-level change. Does not decide architecture.",
      "model": "<set-cheap-model-id>",
      "maxTokens": 8192,
      "options": { "reasoningEffort": "low" },
      "permission": {
        "edit": "allow",
        "bash": {
          "git status": "allow",
          "git diff*": "allow",
          "git add*": "allow",
          "*": "ask"
        }
      }
    },

    "reviewer": {
      "mode": "subagent",
      "description": "Reviews a diff for correctness, security and style. Never edits files itself.",
      "model": "<set-mid-tier-model-id>",
      "maxTokens": 2048,
      "options": { "reasoningEffort": "low" },
      "permission": {
        "edit": "deny",
        "bash": {
          "git diff*": "allow",
          "git log*": "allow",
          "*": "deny"
        }
      }
    },

    "tester": {
      "mode": "subagent",
      "description": "Runs the project's test/lint/build commands and reports raw results.",
      "model": "<set-cheap-model-id>",
      "maxTokens": 1024,
      "options": { "reasoningEffort": "none" },
      "permission": {
        "edit": "deny",
        "bash": {
          "dart test*": "allow",
          "dart analyze*": "allow",
          "flutter test*": "allow",
          "flutter analyze*": "allow",
          "npm test*": "allow",
          "npm run lint*": "allow",
          "*": "deny"
        }
      }
    },

    "marketing": {
      "mode": "all",
      "description": "Business/marketing strategist. Advisory only, doesn't touch code.",
      "model": "<set-mid-tier-model-id>",
      "prompt": "{file:./prompts/marketing.txt}",
      "maxTokens": 4096,
      "options": { "reasoningEffort": "medium" },
      "permission": {
        "edit": {
          "*": "deny",
          "business/**": "allow"
        },
        "bash": "deny",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },

    "writer": {
      "mode": "all",
      "description": "Writes articles, documentation, and marketing copy. Advisory + drafting, doesn't touch code.",
      "model": "<set-mid-tier-model-id>",
      "prompt": "{file:./prompts/writer.txt}",
      "maxTokens": 8192,
      "options": { "reasoningEffort": "low" },
      "permission": {
        "edit": {
          "*": "deny",
          "**/*.md": "allow",
          "business/**": "allow",
          "docs/**": "allow"
        },
        "bash": "deny",
        "webfetch": "allow",
        "websearch": "allow"
      }
    }
  },

  "permission": {
    "*": "ask",

    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa*": "deny",
      "*/wireguard/*": "deny",
      "*/.ssh/*": "deny"
    },

    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*/wireguard/*": "deny",
      "*.pem": "deny",
      "*.key": "deny"
    },

    "external_directory": "deny",

    "bash": {
      "*": "ask",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git branch*": "allow",
      "git checkout -b *": "allow",
      "git checkout main*": "deny",
      "git push origin main*": "deny",
      "git push*": "ask",
      "git merge*": "deny",

      "dart *": "allow",
      "flutter *": "allow",
      "dart run build_runner*": "allow",
      "dart run serverpod_cli*": "allow",
      "serverpod generate*": "allow",
      "serverpod create-migration*": "allow",
      "serverpod apply-migrations*": "ask",
      "npm *": "allow",
      "npx *": "allow",
      "tailwindcss *": "allow",

      "docker compose ps*": "allow",
      "docker compose logs*": "allow",
      "docker ps*": "allow",
      "docker *": "ask",

      "sudo *": "deny",
      "su *": "deny",
      "systemctl *": "deny",
      "reboot*": "deny",
      "shutdown*": "deny",
      "poweroff*": "deny",
      "mkfs*": "deny",
      "dd *": "deny",
      "iptables*": "deny",
      "nft *": "deny",
      "ufw *": "deny",
      "crontab *": "deny",
      "chmod 777*": "deny",
      "chown -R *": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "rm -rf .git*": "deny",
      "curl * | sh": "deny",
      "curl * | bash": "deny",
      "wget * -O- | sh": "deny"
    }
  }
}
