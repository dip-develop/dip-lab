# gtm-mcp - self-hosted Google Tag Manager MCP server.
#
# Copy to .env and fill in. .env is gitignored; never commit it.

# GTM_MCP_VERSION: upstream release to wrap, WITHOUT the leading `v`.
# Rebuild to take effect:  ./manager.sh build gtm-mcp
GTM_MCP_VERSION=1.13.0

# GTM_MCP_API_KEY: shared secret every MCP client must present as
# `Authorization: Bearer <key>`. Generate with:  openssl rand -hex 32
# The dev-agent side needs the SAME value as GTM_MCP_API_KEY in
# dev-agent/.env (compose passes it to the container as-is).
# Required: with it empty the server refuses to start rather than serving MCP
# without authentication.
GTM_MCP_API_KEY=

# GTM_MCP_SERVICE_ACCOUNT_JSON: the Google service-account key JSON on ONE
# line. The service account needs the GTM "Tag Manager" permission on the
# accounts it should manage; create the key in Google Cloud -> IAM ->
# Service Accounts -> Keys.
# Alternative: leave empty and mount the key file instead (see the commented
# GOOGLE_APPLICATION_CREDENTIALS / volume in docker-compose.yml).
GTM_MCP_SERVICE_ACCOUNT_JSON=

# GTM_MCP_TOOL_GROUPS: comma-separated tool families advertised over MCP.
# Default is the inspect/edit core. Other groups: accounts, workspaces, tags,
# triggers, variables, folders, builtins, zones, templates, server, guidance,
# environments, destinations, gtag, container-admin, folder-admin,
# workspace-admin, version-admin, reverts - or `all`.
GTM_MCP_TOOL_GROUPS=accounts,workspaces,tags,triggers,variables,folders

# GTM_MCP_LOG_LEVEL: info (default) or debug.
GTM_MCP_LOG_LEVEL=info

# GTM_MCP_BASE_URL: public URL of this instance. Only used by the OAuth
# metadata endpoints, which s2s mode does not serve; override if the service
# is reached through another hostname.
GTM_MCP_BASE_URL=http://gtm-mcp:8080