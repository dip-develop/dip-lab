# Cloud (Seafile) - needs MySQL database

# Bind address for internal access
BIND_IP=127.0.0.1

# Domain for Traefik
DOMAIN=cloud.example.com

# Database connection (use MySQL from databases service)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=cloud
MYSQL_USER=cloud
MYSQL_PASSWORD=

# Cloud admin
SEAFILE_ADMIN_EMAIL=
SEAFILE_ADMIN_PASSWORD=

TZ=Europe/Berlin