# Cloud (Seafile) - needs MySQL database

# Bind address for internal access
BIND_IP=0.0.0.0

# Domain for Traefik
DOMAIN=cloud.example.com

# Database connection (use MySQL from databases service)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=cloud
MYSQL_USER=cloud
MYSQL_PASSWORD=

# JWT key for Seafile (generate with: openssl rand -base64 32)
JWT_PRIVATE_KEY=

# Redis (cache, shared from databases service)
REDIS_PASSWORD=

# Cloud admin
SEAFILE_ADMIN_EMAIL=
SEAFILE_ADMIN_PASSWORD=

TZ=Europe/Berlin

# Object Storage (S3-compatible) — fill in to enable, leave empty for local NVMe
# Seafile creates prefixes (commit, fs, block) inside the bucket automatically
SEAFILE_USE_S3=
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_PATH_STYLE_REQUEST=true  # enable for self-hosted S3 (MinIO, etc.)

# Cross-service access - uncomment to access other services' data
# GALLERY_LIBRARY_PATH=/mnt/object-storage/gallery/library
# DOCS_DATA_PATH=/mnt/object-storage/docs/data